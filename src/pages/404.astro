---
import Base from '../layouts/Base.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { tools } from '../data/tools';
import { truncate } from '../lib/format';
---

<Base
  title="Page Not Found (404) — DevSnap Developer Tools"
  description={`That page does not exist. Here is the full DevSnap toolbox: ${tools.length} developer tools that all run in your browser.`}
  canonicalPath="/404/"
  noIndex={true}
  hideAds={true}
>
  <div class="wrap wrap-narrow">
    <div class="section center" style="padding-top:80px">
      <p class="muted mono" style="font-size:0.9rem;letter-spacing:0.1em">ERROR 404</p>
      <h1 style="margin-top:6px">That page does not exist</h1>
      <p class="lede" style="max-width:52ch;margin:0 auto 1.4rem">
        The link may be out of date, or the tool may have been renamed. Here is the
        full toolbox — every tool is one click away.
      </p>
      <div class="hero-actions" style="justify-content:center">
        <a class="btn btn-primary" href="/tools/">Browse all {tools.length} tools</a>
        <a class="btn btn-secondary" href="/">Go to the homepage</a>
      </div>
    </div>

    <section class="section">
      <div class="section-head center">
        <h2>Popular tools</h2>
      </div>
      <div class="card-grid">
        {
          ['snapshot', 'json-formatter', 'json-diff', 'regex-tester', 'jwt-decoder', 'qr-generator']
            .map((slug) => tools.find((tool) => tool.slug === slug))
            .filter((tool) => tool !== undefined)
            .map((tool) => (
              <a class="tool-card" href={`/tools/${tool.slug}/`}>
                <span class="tc-name">
                  <span class="tc-glyph" aria-hidden="true"><ToolIcon name={tool.icon} size={17} /></span>
                  {tool.name}
                </span>
                <span class="tc-desc">{truncate(tool.description, 88)}</span>
              </a>
            ))
        }
      </div>
    </section>
  </div>
</Base>
