---
import type { ToolDef } from '../../data/types';

interface Props {
  tool: ToolDef;
}

const { tool } = Astro.props;
---

<div class="tool" data-tool="color-contrast-checker">
  <div class="tool-head">
    <span class="tool-dot" aria-hidden="true"></span>
    <strong>{tool.name}</strong>
    <span>WCAG 2.2 AA and AAA</span>
  </div>
  <div class="tool-body">
    <div class="grid-2">
      <div class="field">
        <label for="cc-foreground">Foreground</label>
        <div class="row">
          <input type="color" id="cc-foreground-picker" value="#1f2937" style="width:52px;height:42px;padding:2px" />
          <input type="text" id="cc-foreground" value="#1f2937" spellcheck="false" />
        </div>
      </div>
      <div class="field">
        <label for="cc-background">Background</label>
        <div class="row">
          <input type="color" id="cc-background-picker" value="#ffffff" style="width:52px;height:42px;padding:2px" />
          <input type="text" id="cc-background" value="#ffffff" spellcheck="false" />
        </div>
      </div>
    </div>

    <div class="callout mt-2" id="cc-preview">
      <p style="margin:0;font-size:1.05rem">
        The quick brown fox jumps over the lazy dog — 16px body text sample.
      </p>
    </div>

    <div class="grid-3 mt-3">
      <div class="fact">
        <span class="fact-label">Contrast ratio</span>
        <span class="fact-value" id="cc-ratio">—</span>
      </div>
      <div class="fact">
        <span class="fact-label">AA normal text (4.5:1)</span>
        <span class="fact-value" id="cc-aa">—</span>
      </div>
      <div class="fact">
        <span class="fact-label">AAA normal text (7:1)</span>
        <span class="fact-value" id="cc-aaa">—</span>
      </div>
    </div>

    <div class="table-wrap mt-3">
      <table>
        <thead><tr><th style="width:240px">Criterion</th><th style="width:120px">Required</th><th>Result</th></tr></thead>
        <tbody id="cc-rows"></tbody>
      </table>
    </div>

    <div class="output">
      <div class="output-label"><span>Suggested alternatives</span></div>
      <div class="output-box" id="cc-suggestions" data-placeholder="Alternatives that pass appear here."></div>
    </div>
  </div>
</div>

<script>
  import { byId } from '../../lib/dom';

  const foregroundInput = byId<HTMLInputElement>('cc-foreground');
  const backgroundInput = byId<HTMLInputElement>('cc-background');
  const foregroundPicker = byId<HTMLInputElement>('cc-foreground-picker');
  const backgroundPicker = byId<HTMLInputElement>('cc-background-picker');
  const preview = byId('cc-preview');
  const ratioBox = byId('cc-ratio');
  const aaBox = byId('cc-aa');
  const aaaBox = byId('cc-aaa');
  const rows = byId('cc-rows');
  const suggestions = byId('cc-suggestions');

  function parseColor(value: string): [number, number, number] | null {
    const text = value.trim().toLowerCase();
    if (/^#[0-9a-f]{3}$/.test(text)) {
      return [
        parseInt(text[1]! + text[1]!, 16),
        parseInt(text[2]! + text[2]!, 16),
        parseInt(text[3]! + text[3]!, 16),
      ];
    }
    if (/^#[0-9a-f]{6}$/.test(text)) {
      return [
        parseInt(text.slice(1, 3), 16),
        parseInt(text.slice(3, 5), 16),
        parseInt(text.slice(5, 7), 16),
      ];
    }
    const rgb = text.match(/^rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)/);
    if (rgb) return [Number(rgb[1]), Number(rgb[2]), Number(rgb[3])];
    const named: Record<string, [number, number, number]> = {
      black: [0, 0, 0],
      white: [255, 255, 255],
      red: [255, 0, 0],
      green: [0, 128, 0],
      blue: [0, 0, 255],
      gray: [128, 128, 128],
      grey: [128, 128, 128],
      yellow: [255, 255, 0],
      orange: [255, 165, 0],
      purple: [128, 0, 128],
    };
    return named[text] ?? null;
  }

  function toHex(rgb: [number, number, number]): string {
    return `#${rgb
      .map((channel) => Math.max(0, Math.min(255, Math.round(channel))).toString(16).padStart(2, '0'))
      .join('')}`;
  }

  function luminance(rgb: [number, number, number]): number {
    const channels = rgb.map((value) => {
      const channel = value / 255;
      return channel <= 0.03928 ? channel / 12.92 : Math.pow((channel + 0.055) / 1.055, 2.4);
    });
    return 0.2126 * channels[0]! + 0.7152 * channels[1]! + 0.0722 * channels[2]!;
  }

  function contrast(a: [number, number, number], b: [number, number, number]): number {
    const first = luminance(a);
    const second = luminance(b);
    const lighter = Math.max(first, second);
    const darker = Math.min(first, second);
    return (lighter + 0.05) / (darker + 0.05);
  }

  function adjust(rgb: [number, number, number], factor: number): [number, number, number] {
    return [
      Math.min(255, rgb[0] * factor),
      Math.min(255, rgb[1] * factor),
      Math.min(255, rgb[2] * factor),
    ];
  }

  function verdict(pass: boolean): string {
    return pass
      ? '<span class="chip chip-ok">Pass</span>'
      : '<span class="chip chip-bad">Fail</span>';
  }

  function update() {
    const foreground = parseColor(foregroundInput?.value ?? '');
    const background = parseColor(backgroundInput?.value ?? '');
    if (!foreground || !background) {
      if (ratioBox) ratioBox.textContent = 'Invalid colour';
      return;
    }

    const ratio = contrast(foreground, background);
    const rounded = Math.round(ratio * 100) / 100;

    if (preview) {
      preview.style.background = toHex(background);
      preview.style.color = toHex(foreground);
      preview.style.borderColor = 'var(--border)';
    }
    if (ratioBox) ratioBox.textContent = `${rounded}:1`;
    if (aaBox) aaBox.innerHTML = verdict(ratio >= 4.5);
    if (aaaBox) aaaBox.innerHTML = verdict(ratio >= 7);

    const criteria: [string, number, boolean][] = [
      ['1.4.3 AA — normal text', 4.5, ratio >= 4.5],
      ['1.4.3 AA — large text', 3, ratio >= 3],
      ['1.4.6 AAA — normal text', 7, ratio >= 7],
      ['1.4.6 AAA — large text', 4.5, ratio >= 4.5],
      ['1.4.11 — UI components and focus indicators', 3, ratio >= 3],
    ];
    if (rows) {
      rows.innerHTML = criteria
        .map(
          ([label, required, pass]) =>
            `<tr><td>${label}</td><td><code>${required}:1</code></td><td>${verdict(pass)}</td></tr>`
        )
        .join('');
    }

    const options: string[] = [];
    if (ratio < 4.5) {
      for (const factor of [0.85, 0.7, 0.55, 0.4, 0.28]) {
        const candidate = adjust(foreground, factor);
        const candidateRatio = contrast(candidate, background);
        if (candidateRatio >= 4.5) {
          options.push(`Darken the text to ${toHex(candidate)} → ${Math.round(candidateRatio * 100) / 100}:1`);
          break;
        }
      }
      for (const factor of [1.2, 1.45, 1.8, 2.2]) {
        const candidate = adjust(background, factor);
        const candidateRatio = contrast(foreground, candidate);
        if (candidateRatio >= 4.5) {
          options.push(`Lighten the background to ${toHex(candidate)} → ${Math.round(candidateRatio * 100) / 100}:1`);
          break;
        }
      }
      for (const factor of [0.7, 0.55, 0.4]) {
        const candidate = adjust(background, factor);
        const candidateRatio = contrast(foreground, candidate);
        if (candidateRatio >= 4.5) {
          options.push(`Darken the background to ${toHex(candidate)} → ${Math.round(candidateRatio * 100) / 100}:1`);
          break;
        }
      }
    }
    if (suggestions) {
      suggestions.textContent = options.length
        ? options.join('\n')
        : 'This pair already meets the AA requirement for normal text.';
    }
  }

  foregroundInput?.addEventListener('input', update);
  backgroundInput?.addEventListener('input', update);
  foregroundPicker?.addEventListener('input', () => {
    if (foregroundInput) foregroundInput.value = foregroundPicker.value;
    update();
  });
  backgroundPicker?.addEventListener('input', () => {
    if (backgroundInput) backgroundInput.value = backgroundPicker.value;
    update();
  });

  update();
</script>
