---
/**
 * Three.js structure view for the JSON diff tool.
 *
 * Every text diff of a JSON payload is a wall of lines. This renders the
 * *shape* of the two documents instead: one tree, built from the union of
 * both, where each node is coloured by what happened to it. You can see at a
 * glance that a field moved, that a subtree is new, or that one leaf changed
 * while the rest of the document is untouched.
 *
 * Clicking a node selects the matching entry in the textual difference list.
 */
---

<div class="diff-scene" id="diff-scene">
  <div class="diff-scene-head">
    <span class="diff-scene-title">Structure</span>
    <div class="diff-scene-legend">
      <span class="chip chip-legend chip-same">unchanged</span>
      <span class="chip chip-legend chip-add">added</span>
      <span class="chip chip-legend chip-rem">removed</span>
      <span class="chip chip-legend chip-chg">changed</span>
    </div>
  </div>
  <div class="diff-scene-canvas">
    <canvas id="diff-canvas"></canvas>
    <p class="diff-scene-hint" id="diff-scene-hint">Paste two JSON documents and compare them to see their structure.</p>
  </div>
</div>

<script>
  import { byId } from '../../lib/dom';

  const container = byId('diff-scene');
  const canvas = byId<HTMLCanvasElement>('diff-canvas');
  const hint = byId('diff-scene-hint');

  type Status = 'same' | 'added' | 'removed' | 'changed';

  interface TreeNode {
    path: string;
    label: string;
    depth: number;
    status: Status;
    children: TreeNode[];
  }

  const STATUS_COLOR: Record<Status, number> = {
    same: 0x64748b,
    added: 0x22c55e,
    removed: 0xef4444,
    changed: 0xf59e0b,
  };

  /** Builds a tree from the union of two JSON documents. */
  function buildTree(
    left: unknown,
    right: unknown,
    changedPaths: Set<string>
  ): TreeNode {
    const MAX_DEPTH = 6;
    const MAX_NODES = 260;

    let count = 0;

    const walk = (
      leftValue: unknown,
      rightValue: unknown,
      path: string,
      label: string,
      depth: number
    ): TreeNode => {
      const isObject =
        leftValue !== null &&
        rightValue !== null &&
        typeof leftValue === 'object' &&
        typeof rightValue === 'object';

      const node: TreeNode = {
        path,
        label,
        depth,
        status: 'same',
        children: [],
      };
      count += 1;

      if (changedPaths.has(path)) {
        node.status =
          leftValue === undefined ? 'added' : rightValue === undefined ? 'removed' : 'changed';
      }

      if (!isObject || depth >= MAX_DEPTH || count > MAX_NODES) return node;

      const leftEntries = Array.isArray(leftValue)
        ? leftValue.map((item, index) => [String(index), item] as const)
        : Object.entries(leftValue as Record<string, unknown>);
      const rightEntries = Array.isArray(rightValue)
        ? rightValue.map((item, index) => [String(index), item] as const)
        : Object.entries(rightValue as Record<string, unknown>);

      const leftMap = new Map(leftEntries);
      const rightMap = new Map(rightEntries);
      const keys = [...new Set([...leftMap.keys(), ...rightMap.keys()])].sort((a, b) => {
        const leftIndex = Number(a);
        const rightIndex = Number(b);
        if (Number.isInteger(leftIndex) && Number.isInteger(rightIndex)) {
          return leftIndex - rightIndex;
        }
        return a.localeCompare(b);
      });

      for (const key of keys) {
        const childPath = path ? `${path}.${key}` : key;
        const child = walk(leftMap.get(key), rightMap.get(key), childPath, key, depth + 1);
        if (child.status === 'same' && (!leftMap.has(key) || !rightMap.has(key))) {
          child.status = leftMap.has(key) ? 'removed' : 'added';
        }
        node.children.push(child);
      }

      return node;
    };

    return walk(left, right, '', 'root', 0);
  }

  /** Flattens the tree and assigns a position to every node. */
  function layout(root: TreeNode) {
    const byDepth = new Map<number, TreeNode[]>();
    const collect = (node: TreeNode) => {
      const list = byDepth.get(node.depth) ?? [];
      list.push(node);
      byDepth.set(node.depth, list);
      node.children.forEach(collect);
    };
    collect(root);

    const nodes: { node: TreeNode; x: number; y: number; z: number }[] = [];
    const edges: { from: [number, number, number]; to: [number, number, number] }[] = [];
    const position = new Map<TreeNode, [number, number, number]>();

    for (const [depth, list] of [...byDepth.entries()].sort((a, b) => a[0] - b[0])) {
      const radius = depth === 0 ? 0 : 2.1 + depth * 1.35;
      list.forEach((node, index) => {
        const golden = 2.399963;
        const angle = index * golden + depth * 0.7;
        const x = depth === 0 ? 0 : Math.cos(angle) * radius;
        const z = depth === 0 ? 0 : Math.sin(angle) * radius;
        const y = depth === 0 ? 0 : -depth * 1.05 + (index % 2 === 0 ? 0.22 : -0.22);
        position.set(node, [x, y, z]);
        nodes.push({ node, x, y, z });
      });
    }

    const link = (node: TreeNode) => {
      const from = position.get(node);
      for (const child of node.children) {
        const to = position.get(child);
        if (from && to) edges.push({ from, to });
        link(child);
      }
    };
    link(root);

    return { nodes, edges };
  }

  if (container && canvas) {
    const start = async () => {
      let THREE: typeof import('three');
      try {
        THREE = await import('three');
      } catch {
        container.remove();
        return;
      }

      let renderer: InstanceType<typeof THREE.WebGLRenderer>;
      try {
        renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      } catch {
        container.remove();
        return;
      }
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 200);
      camera.position.set(0, 1.5, 16);

      const sphere = new THREE.SphereGeometry(0.16, 10, 8);
      const material = new THREE.MeshBasicMaterial({ vertexColors: true, toneMapped: false });
      let mesh: InstanceType<typeof THREE.InstancedMesh> | null = null;
      const edgeMaterial = new THREE.LineBasicMaterial({
        vertexColors: true,
        transparent: true,
        opacity: 0.45,
        depthWrite: false,
      });
      let edgeLines: InstanceType<typeof THREE.LineSegments> | null = null;

      const group = new THREE.Group();
      scene.add(group);

      const dummy = new THREE.Object3D();
      const color = new THREE.Color();
      let paths: string[] = [];

      const rebuild = (left: unknown, right: unknown, changedPaths: Set<string>) => {
        const tree = buildTree(left, right, changedPaths);
        const { nodes, edges } = layout(tree);
        paths = nodes.map((entry) => entry.node.path);

        if (mesh) {
          group.remove(mesh);
          mesh.dispose();
        }
        if (edgeLines) {
          group.remove(edgeLines);
          edgeLines.geometry.dispose();
        }

        mesh = new THREE.InstancedMesh(sphere, material, nodes.length);
        nodes.forEach((entry, index) => {
          dummy.position.set(entry.x, entry.y, entry.z);
          dummy.scale.setScalar(entry.node.status === 'same' ? 0.72 : 1.3);
          dummy.updateMatrix();
          mesh!.setMatrixAt(index, dummy.matrix);
          mesh!.setColorAt(index, color.setHex(STATUS_COLOR[entry.node.status]));
        });
        mesh.instanceMatrix.needsUpdate = true;
        if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;
        group.add(mesh);

        const positions: number[] = [];
        const colors: number[] = [];
        for (const edge of edges) {
          positions.push(...edge.from, ...edge.to);
          const child = nodes.find((entry) =>
            edge.to.every((value, axis) => value === [entry.x, entry.y, entry.z][axis])
          );
          const hex = child ? STATUS_COLOR[child.node.status] : STATUS_COLOR.same;
          const c = new THREE.Color(hex);
          colors.push(c.r, c.g, c.b, c.r, c.g, c.b);
        }
        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
        geometry.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
        edgeLines = new THREE.LineSegments(geometry, edgeMaterial);
        group.add(edgeLines);
      };

      const resize = () => {
        const rect = canvas.parentElement!.getBoundingClientRect();
        const width = Math.max(1, rect.width);
        const height = Math.max(1, rect.height);
        renderer.setSize(width, height, false);
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
      };
      resize();
      const observer = new ResizeObserver(resize);
      observer.observe(canvas.parentElement!);

      // Picking: click a node to find its entry in the difference list.
      const raycaster = new THREE.Raycaster();
      const pointer = new THREE.Vector2();

      canvas.addEventListener('pointerup', (event) => {
        if (!mesh) return;
        const rect = canvas.getBoundingClientRect();
        pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(pointer, camera);
        const hits = raycaster.intersectObject(mesh);
        const instanceId = hits[0]?.instanceId;
        if (instanceId === undefined) return;
        const path = paths[instanceId];
        if (!path) return;
        document.dispatchEvent(
          new CustomEvent('devsnap:select-path', { detail: { path } })
        );
      });

      const clock = new THREE.Clock();
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let visible = true;
      let inView = true;

      document.addEventListener('visibilitychange', () => {
        visible = document.visibilityState === 'visible';
      });
      const intersection = new IntersectionObserver(
        (entries) => {
          inView = entries[0]?.isIntersecting ?? true;
        },
        { threshold: 0 }
      );
      intersection.observe(container);

      const loop = () => {
        requestAnimationFrame(loop);
        if (!visible || !inView) return;
        const elapsed = clock.getElapsedTime();
        if (!reduceMotion) {
          group.rotation.y = elapsed * 0.12;
          group.rotation.x = Math.sin(elapsed * 0.25) * 0.14;
          group.position.y = Math.sin(elapsed * 0.4) * 0.16;
        }
        renderer.render(scene, camera);
      };
      loop();

      // The tool dispatches the parsed documents and the changed paths.
      document.addEventListener('devsnap:json-diff', (event) => {
        const detail = (event as CustomEvent).detail as {
          left: unknown;
          right: unknown;
          changed: string[];
        };
        if (hint) hint.style.display = 'none';
        rebuild(detail.left, detail.right, new Set(detail.changed));
      });
    };

    if ('requestIdleCallback' in window) {
      (window as Window & { requestIdleCallback: (cb: () => void) => void }).requestIdleCallback(
        () => void start()
      );
    } else {
      setTimeout(() => void start(), 200);
    }
  }
</script>
