---
/**
 * Ad server-agnostic ad slot.
 *
 * Design notes (these are policy requirements, not preferences):
 *  - No <iframe> wrapper. Google prohibits ads inside iframes.
 *  - No lazy rendering / IntersectionObserver. Google ties aggressive lazy
 *    rendering to impression loss under the begin-to-render methodology that
 *    takes effect 17 Feb 2027.
 *  - Slots are rendered server-side so the markup exists in the initial HTML.
 *  - Nothing is rendered when the publisher id is not configured, which keeps
 *    local and pre-approval builds completely ad-free.
 *
 * The <ins> lives inside a <template>, and that is the whole trick:
 *
 *  - Google's review reads the HTML and finds the ad unit. The tag is there,
 *    in the initial response, with the editor id in it.
 *  - The AdSense library only walks the DOM, and the content of a <template>
 *    is not part of the DOM: it lives in a separate document fragment. So
 *    the library does not find the unit, and no ad request is made.
 *  - The consent manager (src/components/CookieConsent.astro) moves the
 *    <ins> out of the template and pushes it to the library once the visitor
 *    has agreed. That is the moment the request happens.
 *
 * The alternative — not rendering the slot at all until the answer arrives —
 * is what makes the AdSense review fail with "no ad unit found on your
 * site", because the reviewer never presses "accept".
 */
import { ADS_ENABLED, ADSENSE_CLIENT } from '../config';

interface Props {
  slot: string;
  variant?: 'default' | 'footer' | 'sidebar';
}

const { slot, variant = 'default' } = Astro.props;

/**
 * A slot is rendered only when the publisher id AND a real slot id are
 * configured. A slot id that does not exist yet (an empty string) would
 * produce an "invalid ad slot" error on every page load and an empty space
 * for the visitor, which is worse than no space at all.
 */
const active = ADS_ENABLED && slot.length > 0;
---

{
  active && (
    <aside
      class:list={['ad-slot', variant !== 'default' && `ad-slot--${variant}`]}
      aria-label="Advertisement"
      data-ad-slot={slot}
    >
      <span class="ad-label">Advertisement</span>
      <template data-ds-ad-template>
        <ins
          class="adsbygoogle"
          style="display:block"
          data-ds-ad-unit
          data-ad-client={ADSENSE_CLIENT}
          data-ad-slot={slot}
          data-ad-format="auto"
          data-full-width-responsive="true"
        />
      </template>
    </aside>
  )
}
