---
/**
 * Ad server-agnostic ad slot.
 *
 * Design notes (these are policy requirements, not preferences):
 *  - No <iframe> wrapper. Google prohibits ads inside iframes.
 *  - No lazy rendering / IntersectionObserver. Google ties aggressive lazy
 *    rendering to impression loss under the begin-to-render methodology that
 *    takes effect 17 Feb 2027.
 *  - Slots are rendered server-side so the markup exists in the initial HTML.
 *  - Nothing is rendered when the publisher id is not configured, which keeps
 *    local and pre-approval builds completely ad-free.
 */
import { ADS_ENABLED, ADSENSE_CLIENT } from '../config';

interface Props {
  slot: string;
  variant?: 'default' | 'footer' | 'sidebar';
}

const { slot, variant = 'default' } = Astro.props;
const active = ADS_ENABLED;
---

{
  active && (
    <aside
      class:list={['ad-slot', variant !== 'default' && `ad-slot--${variant}`]}
      aria-label="Advertisement"
      data-ad-slot={slot}
    >
      <span class="ad-label">Advertisement</span>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={ADSENSE_CLIENT}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>
        // Two rules, applied per slot rather than per page:
        //
        //  - In the EEA, the UK and Switzerland, no ad request is made until
        //    the visitor has explicitly agreed. The slot is hidden rather
        //    than filled, because an empty box is worse than no box.
        //  - Everywhere else the request is made with npa=1 until consent is
        //    granted, which serves non-personalised advertising: measured,
        //    but not based on a profile of interests.
        (function () {
          var script = document.currentScript;
          var aside = script ? script.parentElement : null;
          var ins = aside ? aside.querySelector('ins.adsbygoogle') : null;
          var consent = window.__adsConsent;
          var regulated = window.__adsIsEea === true;

          if (regulated && consent !== 'granted') {
            if (aside) aside.hidden = true;
            return;
          }

          if (ins && consent !== 'granted') ins.setAttribute('data-npa', '1');
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        })();
      </script>
    </aside>
  )
}
