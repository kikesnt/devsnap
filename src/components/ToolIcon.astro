---
/**
 * Inline SVG icon set.
 *
 * Every icon is drawn on the same 24×24 grid with a 1.7 stroke, round caps
 * and round joins, so a grid of them looks deliberate rather than assembled.
 * They inherit `currentColor`, which means one CSS rule themes all of them.
 */

import type { IconName } from '../data/types';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;

const paths: Record<IconName, string> = {
