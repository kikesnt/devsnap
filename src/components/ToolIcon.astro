  id: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><circle cx="9" cy="11" r="2"/><path d="M6 16.5c.6-1.6 1.7-2.3 3-2.3s2.4.7 3 2.3M15 9.5h4M15 13h4"/>',
