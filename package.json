{
  "name": "devsnap",
  "version": "1.0.0",
  "description": "DevSnap \u2014 a client-side developer toolbox. Every tool runs entirely in your browser.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-libs.ts",
    "verify": "node scripts/verify.mjs",
    "build:ads": "PUBLIC_ADSENSE_CLIENT=pub-0000000000000000 astro build",
    "check:ads": "npm run build:ads && node scripts/verify.mjs",
    "og": "node scripts/generate-og.mjs",
    "smoke": "node scripts/smoke.mjs",
    "seo": "node scripts/seo-audit.mjs",
    "lint:strings": "node scripts/lint-strings.mjs"
  },
  "keywords": [
    "developer-tools",
    "json",
    "regex",
    "client-side"
  ],
  "license": "MIT",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2",
    "qrcode-generator": "^2.0.4",
    "three": "^0.186.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
